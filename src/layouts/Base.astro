---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  active?: string;
}

const { title, description, active = "" } = Astro.props;
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <script is:inline>
    /* terapkan tema tersimpan sebelum halaman dicat — hindari kedip */
    (function () {
      try {
        var t = localStorage.getItem("ek-theme");
        if (!t) t = (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) ? "dark" : "light";
        if (t === "dark") document.documentElement.setAttribute("data-theme", "dark");
      } catch (e) {}
    })();
  </script>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23f4efe4'/%3E%3Cpath d='M4 26 L28 6' stroke='%23b4432e' stroke-width='3' fill='none'/%3E%3Cpath d='M4 6 L28 26' stroke='%231e5f45' stroke-width='3' fill='none'/%3E%3C/svg%3E" />
</head>
<body>
<a class="skip-link" href="#top">Lewati ke isi halaman</a>

<header class="site-header">
  <div class="container">
    <a class="brand" href="index.html">EKONOMI <b>MIKRO</b></a>
    <nav class="site-nav" aria-label="Navigasi utama">
      <a href="index.html" aria-current={active === "beranda" ? "true" : undefined}>Beranda</a>
      <a href="materi.html" aria-current={active === "materi" ? "true" : undefined}>Materi</a>
      <a href="rumus.html" aria-current={active === "rumus" ? "true" : undefined}>Rumus</a>
      <a href="kasus.html" aria-current={active === "kasus" ? "true" : undefined}>Kasus Nyata</a>
      <a href="kalkulator.html" aria-current={active === "kalkulator" ? "true" : undefined}>Kalkulator</a>
    </nav>
    <button class="theme-btn" type="button" data-theme-toggle aria-label="Ganti mode terang atau gelap" aria-pressed="false" title="Mode terang / gelap">
      <svg class="ic ic-moon" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M13 9.8A5.6 5.6 0 0 1 6.2 3 5.7 5.7 0 1 0 13 9.8Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
      <svg class="ic ic-sun" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M12.6 3.4l-1.4 1.4M4.8 11.2 3.4 12.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <span class="theme-btn-txt">Gelap</span>
    </button>
  </div>
</header>

<slot />

<footer class="site-footer">
  <div class="container">
    <div class="foot-grid">
      <div>
        <p class="mono">EKONOMI MIKRO — materi, rumus, kasus, kalkulator</p>
        <p>Disusun dari catatan kuliah <em>Pengantar Ilmu Ekonomi I (Ekonomi Mikro)</em> — Munarotul Fatati, S.E., M.M.</p>
      </div>
      <div>
        <p class="mono">Tanpa internet · tanpa pelacakan</p>
        <p>Seluruh perhitungan dan grafik berjalan lokal di peramban: buka <span class="mono">index.html</span> kapan saja.</p>
      </div>
    </div>
  </div>
</footer>

<script is:inline src="/js/theme.js"></script>
<script is:inline src="/js/charts.js"></script>
<script is:inline src="/js/app.js"></script>
</body>
</html>
